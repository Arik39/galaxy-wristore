      "css": ".ds-tabs{display:flex;justify-content:space-around;width:360px;height:56px;align-items:center;background:#09090A;border-top:1px solid rgba(237,239,242,0.08)}.ds-tabs a{display:flex;flex-direction:column;align-items:center;gap:5px;color:#7A7F88;cursor:pointer}.ds-tabs a:hover{color:#A8ADB5}.ds-tabs a.ds-on{color:#EDEFF2}.ds-tabs i{width:4px;height:4px;border-radius:50%;background:#EDEFF2}"
