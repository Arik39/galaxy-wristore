    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The screen's one filled action.",
      "html": "<button class=\"ds-btn-primary\">BACK UP NOW</button>",
      "css": ".ds-btn-primary{background:#EDEFF2;color:#09090A;border:none;border-radius:3px;min-height:46px;padding:14px 20px;font:700 12px/16px system-ui,-apple-system,Roboto,sans-serif;letter-spacing:2.4px;text-transform:uppercase;width:320px;cursor:pointer;transition:background 280ms cubic-bezier(0.16,1,0.3,1)}.ds-btn-primary:hover{background:rgba(237,239,242,0.92)}.ds-btn-primary:active{background:rgba(237,239,242,0.85)}.ds-btn-primary:focus-visible{outline:1px solid #EDEFF2;outline-offset:3px}"
    },
    {
      "name": "Outlined Button",
      "kind": "button",
      "refersTo": "button-outlined",
