    {
      "name": "Segmented Choice",
      "kind": "chip",
      "refersTo": "segment-selected",
      "description": "Selected segment is lit graphite, never white.",
      "html": "<div class=\"ds-seg\"><button class=\"ds-seg-on\">FACES</button><button>APPS</button></div>",
      "css": ".ds-seg{display:flex;width:320px;border:1px solid rgba(237,239,242,0.18);border-radius:3px;overflow:hidden;background:#09090A}.ds-seg button{flex:1;background:transparent;color:#A8ADB5;border:none;padding:14px 8px;font:700 12px/16px system-ui,-apple-system,Roboto,sans-serif;letter-spacing:2.4px;cursor:pointer}.ds-seg button+button{border-left:1px solid rgba(237,239,242,0.18)}.ds-seg .ds-seg-on{background:#1C1D21;color:#EDEFF2}.ds-seg button:hover{color:#EDEFF2}.ds-seg button:focus-visible{outline:1px solid #EDEFF2;outline-offset:-2px}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Graphite fill, hairline edge, ink border on focus.",
      "html": "<label class=\"ds-field\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#A8ADB5\" stroke-width=\"1.7\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"6.5\"/><path d=\"M16 16l4.5 4.5\"/></svg><input placeholder=\"Search Tizen Archive\"></label>",
      "css": ".ds-field{display:flex;align-items:center;gap:12px;width:320px;padding:12px 14px;background:#141518;border:1px solid rgba(237,239,242,0.18);border-radius:3px}.ds-field:focus-within{border-color:#EDEFF2}.ds-field input{flex:1;background:transparent;border:none;outline:none;color:#EDEFF2;font:400 16px/22px system-ui,-apple-system,Roboto,sans-serif}.ds-field input::placeholder{color:#7A7F88}"
    },
    {
      "name": "Spec Row",
      "kind": "custom",
      "refersTo": null,
      "description": "Tracked label left, value flush right, hairline under; red value only at risk.",
      "html": "<div class=\"ds-spec\"><div class=\"ds-row\"><span>VERSION</span><b>1.0.1</b></div><div class=\"ds-row\"><span>BACKUP</span><b class=\"ds-risk\">Not backed up</b></div></div>",
      "css": ".ds-spec{width:340px;background:#09090A;padding:0 4px}.ds-row{display:flex;align-items:baseline;justify-content:space-between;gap:16px;padding:13px 0;border-bottom:1px solid rgba(237,239,242,0.18)}.ds-row span{font:600 11px/15px system-ui,-apple-system,Roboto,sans-serif;letter-spacing:2.2px;color:#7A7F88}.ds-row b{font:400 16px/22px system-ui,-apple-system,Roboto,sans-serif;color:#EDEFF2}.ds-row b.ds-risk{color:#E2554F}"
    },
    {
      "name": "Readouts",
      "kind": "custom",
      "refersTo": null,
      "description": "Tabular Archivo figures over faint tracked labels, split by hairlines.",
      "html": "<div class=\"ds-readouts\"><div><b>72%</b><span>BATTERY</span></div><div><b class=\"ds-risk\">11/14</b><span>BACKED UP</span></div></div>",
      "css": ".ds-readouts{display:flex;width:340px;border-top:1px solid rgba(237,239,242,0.18);padding-top:16px;background:#09090A}.ds-readouts div{flex:1;display:flex;flex-direction:column;gap:4px;padding-left:16px}.ds-readouts div+div{border-left:1px solid rgba(237,239,242,0.18)}.ds-readouts div:first-child{padding-left:0}.ds-readouts b{font:350 26px/30px Archivo,sans-serif;font-variation-settings:'wdth' 112,'wght' 350;font-variant-numeric:tabular-nums;color:#EDEFF2}.ds-readouts b.ds-risk{color:#E2554F}.ds-readouts span{font:600 11px/15px system-ui,-apple-system,Roboto,sans-serif;letter-spacing:2.2px;color:#7A7F88}"
    },
